{
  "manifest_version": 3,

  "name": "Anchor",
  "version": "1.0",

  "description": "A mindful shopping assistant that helps you pause before purchasing.",

  "permissions": [
    "storage"
  ],

  "host_permissions": [
    "*://*/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "content/panel.html",
        "icons/icon16.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}